{
  "info": {
    "name": "Location Processing API Tests",
    "description": "Тесты для функциональности администрирования локаций",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Admin Location Operations",
      "item": [
        {
          "name": "Create Location",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has id', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData.id).to.not.be.null;",
                  "});",
                  "",
                  "pm.test('Response has correct name', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.name).to.eql('Test Location');",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set('locationId', jsonData.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "1"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Location\",\n  \"lat\": 55.754167,\n  \"lon\": 37.62,\n  \"address\": \"Red Square, Moscow\",\n  \"description\": \"Main square of Moscow\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/admin/locations",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["admin", "locations"]
            }
          }
        },
        {
          "name": "Create Location Duplicate - Should Fail",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 409', function() {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "1"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Location\",\n  \"lat\": 55.754167,\n  \"lon\": 37.62,\n  \"address\": \"Red Square, Moscow\",\n  \"description\": \"Main square of Moscow\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/admin/locations",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["admin", "locations"]
            }
          }
        },
        {
          "name": "Get Location By Id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has correct id', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.eql(parseInt(pm.environment.get('locationId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/locations/{{locationId}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["locations", "{{locationId}}"]
            }
          }
        },
        {
          "name": "Update Location",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Name was updated', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.name).to.eql('Updated Location');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-User-Id",
                "value": "1"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Location\",\n  \"lat\": 55.754167,\n  \"lon\": 37.62,\n  \"address\": \"Red Square, Moscow\",\n  \"description\": \"Updated description\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/admin/locations/{{locationId}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["admin", "locations", "{{locationId}}"]
            }
          }
        },
        {
          "name": "Get All Locations",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is array', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/locations?from=0&size=10",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["locations"],
              "query": [
                {
                  "key": "from",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Location",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 204', function() {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-User-Id",
                "value": "1"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/admin/locations/{{locationId}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["admin", "locations", "{{locationId}}"]
            }
          }
        }
      ]
    },
